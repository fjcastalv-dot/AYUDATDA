# Configuración de Google Calendar API (Google Identity Services)
# Obtén tu Client ID en Google Cloud Console -> APIs & Services -> Credentials
# Asegúrate de autorizar tu origen de JavaScript: http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu_cliente_id_aqui.apps.googleusercontent.com

# Clave de API de Google (opcional para lectura de recursos públicos)
NEXT_PUBLIC_GOOGLE_API_KEY=
